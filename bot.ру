import json
from aiogram import Bot, Dispatcher, types
from aiogram.utils import executor

TOKEN = "8312219182:AAGaokNUp8fuyW-Bkmj0xje5oJJgkVHpT9E"

DB_FILE = "artists.json"
ADMIN_FILE = "admins.json"

bot = Bot(token=TOKEN)
dp = Dispatcher(bot)

def load_json(file):
    try:
        with open(file, "r", encoding="utf-8") as f:
            return json.load(f)
    except:
        return []

def save_json(file, data):
    with open(file, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def is_admin(user_id):
    admins = load_json(ADMIN_FILE)
    return user_id in admins

def artist_keyboard():
    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            artists = json.load(f)
    except:
        artists = {}

    kb = types.InlineKeyboardMarkup(row_width=1)
    for name, link in artists.items():
        kb.add(types.InlineKeyboardButton(text=f"🎧 {name}", url=link))
    return kb

@dp.message_handler(commands=["start"])
async def start(message: types.Message):
    await message.answer(
        "🎶 Закрытый Artist Hub\n\nВыбирай артиста:",
        reply_markup=artist_keyboard()
    )

@dp.message_handler(commands=["add"])
async def add_artist(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    try:
        _, name, link = message.text.split(" ", 2)

        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                artists = json.load(f)
        except:
            artists = {}

        artists[name] = link

        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(artists, f, ensure_ascii=False, indent=2)

        await message.answer(f"✅ Артист {name} добавлен")
    except:
        await message.answer("Формат:\n/add Имя https://t.me/канал")

@dp.message_handler(commands=["remove"])
async def remove_artist(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    try:
        _, name = message.text.split(" ", 1)

        with open(DB_FILE, "r", encoding="utf-8") as f:
            artists = json.load(f)

        if name in artists:
            del artists[name]
            with open(DB_FILE, "w", encoding="utf-8") as f:
                json.dump(artists, f, ensure_ascii=False, indent=2)
            await message.answer(f"🗑️ Артист {name} удалён")
        else:
            await message.answer("Такого артиста нет")
    except:
        await message.answer("Формат:\n/remove Имя")

@dp.message_handler(commands=["list"])
async def list_artists(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            artists = json.load(f)
    except:
        artists = {}

    if not artists:
        await message.answer("Список пуст")
        return

    text = "🎤 Артисты:\n\n"
    for name, link in artists.items():
        text += f"{name} — {link}\n"

    await message.answer(text)

@dp.message_handler(commands=["admins"])
async def list_admins(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    admins = load_json(ADMIN_FILE)
    text = "👑 Админы:\n\n"
    for a in admins:
        text += f"{a}\n"
    await message.answer(text)

@dp.message_handler(commands=["addadmin"])
async def add_admin(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    try:
        _, new_id = message.text.split(" ", 1)
        new_id = int(new_id)

        admins = load_json(ADMIN_FILE)
        if new_id not in admins:
            admins.append(new_id)
            save_json(ADMIN_FILE, admins)
            await message.answer(f"👑 Админ {new_id} добавлен")
        else:
            await message.answer("Он уже админ")
    except:
        await message.answer("Формат:\n/addadmin 123456789")

@dp.message_handler(commands=["removeadmin"])
async def remove_admin(message: types.Message):
    if not is_admin(message.from_user.id):
        return

    try:
        _, rem_id = message.text.split(" ", 1)
        rem_id = int(rem_id)

admins = load_json(ADMIN_FILE)
        if rem_id in admins:
            admins.remove(rem_id)
            save_json(ADMIN_FILE, admins)
            await message.answer(f"🗑️ Админ {rem_id} удалён")
        else:
            await message.answer("Такого админа нет")
    except:
        await message.answer("Формат:\n/removeadmin 123456789")

executor.start_polling(dp)